@model List<StudentManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Student Records";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Student Records</h2>
        <div>
            <a asp-controller="Student" asp-action="Create"
               class="btn btn-primary">+ Add Student</a>
            <a asp-controller="Account" asp-action="Logout"
               class="btn btn-outline-secondary">Logout</a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input type="text" name="search" value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by name or roll number" />
        </div>

        <div class="col-md-3">
            <select name="sortOrder" class="form-select">
                <option value="roll">Sort by Roll No.</option>
                <option value="name">Sort by Name</option>
                <option value="dob">Sort by Date of Birth</option>
                <option value="gender">Sort by Gender</option>
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-success w-100">
                Search / Sort
            </button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Roll No.</th>
                    <th>Name</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            No student records found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.Roll_No</td>
                            <td>@student.Name</td>
                            <td>@student.DOB.ToString("dd/MM/yyyy")</td>
                            <td>@student.Gender</td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@student.Id"
                                   class="btn btn-sm btn-warning">Edit</a>

                                <form asp-action="Delete" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this student?');">
                                    <input type="hidden" name="id"
                                           value="@student.Id" />
                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
