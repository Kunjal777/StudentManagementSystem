@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<div class="container mt-4">
    <h2>Add Student</h2>

    <form asp-controller="Student" asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Student Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Roll_No" class="form-label">Roll Number</label>
            <input asp-for="Roll_No" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="DOB" class="form-label">Date of Birth</label>
            <input asp-for="DOB" type="date" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Gender" class="form-label">Gender</label>
            <select asp-for="Gender" class="form-select" required>
                <option value="">-- Select Gender --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save Student</button>
        <a asp-controller="Student" asp-action="Index"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>
